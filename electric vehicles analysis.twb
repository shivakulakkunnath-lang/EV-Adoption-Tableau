      <column caption='Total vehicles' datatype='integer' name='[Calculation_0160316902473728]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([DOL Vehicle ID])' />
      </column>
      <column caption='Avg Electric Range' datatype='real' name='[Calculation_0160316903989249]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Electric Range])' />
      </column>
      <column caption='Total BEV Vehicles' datatype='integer' name='[Calculation_0160316906852355]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF  [Electric Vehicle Type] = &quot;Battery Electric Vehicle (BEV)&quot;&#13;&#10;THEN [DOL Vehicle ID]&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='% of BEV vehicles' datatype='real' name='[Calculation_0160316908146692]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0160316906852355] / [Calculation_0160316902473728]' />
      </column>
      <column caption='Total  PBEV Vehicles ' datatype='integer' name='[Calculation_0160316909195269]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [Electric Vehicle Type] = &quot;Plug-in Hybrid Electric Vehicle (PHEV)&quot;&#13;&#10;THEN&#13;&#10;[DOL Vehicle ID]&#13;&#10;END)' />
      </column>
      <column caption='Total  PHEV Vehicles ' datatype='integer' name='[Calculation_0160316910088199]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [Electric Vehicle Type] = &quot;Plug-in Hybrid Electric Vehicle (PHEV)&quot;&#13;&#10;THEN&#13;&#10;[DOL Vehicle ID]&#13;&#10;END)' />
      </column>
      <column caption='% of PHEV vehicles' datatype='real' name='[Calculation_0160316910731272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0160316910088199]/[Calculation_0160316902473728]' />
      </column>
